<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>title</key>
	<string>Twin</string>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>唤醒方式</string>
			<key>footerText</key>
			<string>总开关关闭时 Twin 完全不生效，保持 ParallelX 原本行为。开启 Arc 后在屏幕边缘（避开顶部与底部系统手势区）按住并向屏幕内侧拖动即可唤出弧形菜单。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>启用 Twin</string>
			<key>key</key>
			<string>TWEnabled</string>
			<key>default</key>
			<false/>
			<key>footerText</key>
			<string>总开关：关闭后保持 ParallelX 原本行为，弧形手势与 Crane 均不生效。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Arc 弧形唤醒</string>
			<key>key</key>
			<string>TWArcEnabled</string>
			<key>default</key>
			<true/>
			<key>footerText</key>
			<string>开启后，在屏幕边缘（避开顶部状态栏与底部 Home 条区域）按住并向屏幕内侧拖动，即可唤出弧形应用菜单；松手选中图标打开应用。关闭则完全沿用原来的唤醒方式。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>从右边缘唤醒</string>
			<key>key</key>
			<string>TWArcSide</string>
			<key>default</key>
			<false/>
			<key>footerText</key>
			<string>关闭 = 从左侧边缘触发；开启 = 从右侧边缘触发。菜单图标会从该侧向屏幕内侧展开。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>label</key>
			<string>触发区宽度</string>
			<key>key</key>
			<string>TWArcTriggerWidth</string>
			<key>default</key>
			<integer>24</integer>
			<key>min</key>
			<integer>8</integer>
			<key>max</key>
			<integer>60</integer>
			<key>showValue</key>
			<true/>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>label</key>
			<string>菜单图标数量</string>
			<key>key</key>
			<string>TWArcItemCount</string>
			<key>default</key>
			<integer>6</integer>
			<key>min</key>
			<integer>2</integer>
			<key>max</key>
			<integer>8</integer>
			<key>showValue</key>
			<true/>
			<key>footerText</key>
			<string>取最近使用应用（含已安装用户应用兜底）。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>label</key>
			<string>菜单半径</string>
			<key>key</key>
			<string>TWArcRadius</string>
			<key>default</key>
			<integer>140</integer>
			<key>min</key>
			<integer>90</integer>
			<key>max</key>
			<integer>240</integer>
			<key>showValue</key>
			<true/>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>音效与震动</string>
			<key>key</key>
			<string>TWArcSoundEnabled</string>
			<key>default</key>
			<true/>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Crane 分身</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Crane 分身支持</string>
			<key>key</key>
			<string>TWCraneEnabled</string>
			<key>default</key>
			<false/>
			<key>footerText</key>
			<string>需要已安装 Crane（libcrane.dylib / CraneManager）。开启后，ParallelX 每打开一个列出的应用，都会先切换到对应分身容器再启动；未安装 Crane 时自动禁用，不影响任何启动。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSLinkListCell</string>
			<key>label</key>
			<string>分身应用列表</string>
			<key>detail</key>
			<string>TWCraneAppsController</string>
			<key>isController</key>
			<true/>
			<key>key</key>
			<string>TWCraneApps</string>
			<key>footerText</key>
			<string>为每个应用填写 Crane 容器 ID（在 Crane 的设置里可查看）：ParallelX 打开该应用时会以该分身容器启动。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>关于</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSStaticTextCell</string>
			<key>label</key>
			<string>Twin 0.1.0</string>
			<key>footerText</key>
			<string>Arc 弧形唤醒 + Crane 分身，为 ParallelX 分屏打造。作者：Niubiprass。设置保存在越狱根目录私有的偏好文件，不写入系统真实偏好路径。</string>
		</dict>
	</array>
</dict>
</plist>
