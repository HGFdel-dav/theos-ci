// GeckoView's EventCallback (ObjC protocol in the framework). Declared here so
// the .xm compiles as ObjC++ without dragging in the framework headers.
@protocol RDEventCallback <NSObject>
- (void)sendSuccess:(id)response;
- (void)sendError:(id)response;
@end

@protocol RDGeckoDispatch <NSObject>
- (void)dispatchToGecko:(NSString *)type message:(id)message callback:(id<RDEventCallback>)callback;
@end

static NSString *RDLogPath(void) {
    static NSString *path;
    static dispatch_once_t once;
    dispatch_once(&once, ^{
        path = [NSTemporaryDirectory() stringByAppendingPathComponent:@"ReynardDefault.log"];
    });
    return path;
}

#ifdef REYNARD_STRIP_LOGS
#define RDNSLog(...) do {} while (0)
#else
#define RDNSLog(...) NSLog(__VA_ARGS__)
#endif

static void RDLog(NSString *format, ...) {
    va_list args;
    va_start(args, format);
    NSString *line = [[NSString alloc] initWithFormat:format arguments:args];
    va_end(args);
    RDNSLog(@"%@ %@", RD_TAG, line);

    NSString *path = RDLogPath();
    NSFileManager *fm = [NSFileManager defaultManager];
    NSDictionary *attributes = [fm attributesOfItemAtPath:path error:NULL];
    unsigned long long size = [[attributes objectForKey:NSFileSize] unsignedLongLongValue];
    if (attributes && size > 256 * 1024) {
        [fm removeItemAtPath:path error:NULL];
        attributes = nil;
    }
    NSString *entry = [NSString stringWithFormat:@"%@ %@ %@\n", [NSDate date], RD_TAG, line];
    NSData *data = [entry dataUsingEncoding:NSUTF8StringEncoding];
    if (!attributes) {
        [data writeToFile:path atomically:YES];
        return;
    }
    NSFileHandle *handle = [NSFileHandle fileHandleForWritingAtPath:path];
    if (!handle) return;
    @try {
        [handle seekToEndOfFile];
        [handle writeData:data];
    } @catch (NSException *exception) {
        (void)exception;
    }
    [handle closeFile];
}

static BOOL RDBoolValue(id value, BOOL fallback) {
    if (!value || value == [NSNull null]) return fallback;
    if ([value isKindOfClass:[NSNumber class]] || [value isKindOfClass:[NSString class]]) {
        return [value boolValue];
    }
    return fallback;
}

static void RDLogOnce(NSString *type, id payload);

static void RDLogTypeOnce(NSString *type) {
    static NSMutableSet *seen;
    static dispatch_once_t once;
    dispatch_once(&once, ^{ seen = [NSMutableSet set]; });
    @synchronized (seen) {
        if ([seen containsObject:type]) return;
        [seen addObject:type];
        RDLog(@"event type %@", type);
    }
}

// Clicks on unknown schemes produce no request event at all in this build; the
// only signal is the history event. Keep a short window so one click cannot
// open twice when several events describe it.
// Some extension events only need to be seen once per type, with their payload.
static void RDLogOnce(NSString *type, id payload) {
    static NSMutableSet *seen;
    static dispatch_once_t once;
    dispatch_once(&once, ^{ seen = [NSMutableSet set]; });
    @synchronized (seen) {
        NSString *key = [NSString stringWithFormat:@"%@|%@", type, payload];
        if ([seen containsObject:key]) return;
        [seen addObject:key];
        RDLog(@"%@ %@", type, payload);
    }
}

static BOOL RDClaimHandoff(NSString *uri) {
    static NSString *lastURI;
    static NSTimeInterval lastAt;
    NSTimeInterval now = [NSDate timeIntervalSinceReferenceDate];
    if (lastURI && [lastURI isEqualToString:uri] && now - lastAt < 3.0) return NO;
    lastURI = [uri copy];
    lastAt = now;
    return YES;
}

static NSSet *RDInternalSchemes(void);

@interface RDEnsureCallback : NSObject <RDEventCallback>
@end

static RDEnsureCallback *rdEnsureCallback;
static id rdGeckoBackend;
static BOOL rdEnsureDone;

static NSHashTable *rdDispatchers;
static id rdRuntimeBackend;
static void (*rdOrigDispatch)(id, SEL, NSString *, id, id);
static BOOL rdInstallTried;
static BOOL rdInstallBroadcasted;
static int rdInstallCounter;
static BOOL rdAddonConfirmed;

// Last resort: register the extension straight in the profile's extensions.json.
// The engine never scans our file in on its own, and install() rejects it (-5),
// but an existing DB record with a file rootURI is what a sideloaded add-on
// looks like, so write that record ourselves before the runtime starts.
static void RDSeedExtensionsDatabase(void) {
    NSString *base = [NSHomeDirectory() stringByAppendingPathComponent:
                      @"Library/Application Support/.mozilla/firefox"];
    NSFileManager *fm = [NSFileManager defaultManager];
    for (NSString *profile in [fm contentsOfDirectoryAtPath:base error:NULL] ?: @[]) {
        NSString *dir = [base stringByAppendingPathComponent:profile];
        NSString *dbPath = [dir stringByAppendingPathComponent:@"extensions.json"];
        NSString *xpiPath = [dir stringByAppendingPathComponent:@"extensions/reynarddefault@local.xpi"];
        if (![fm fileExistsAtPath:dbPath] || ![fm fileExistsAtPath:xpiPath]) continue;

        NSData *raw = [NSData dataWithContentsOfFile:dbPath];
        NSMutableDictionary *db = raw ? [[NSJSONSerialization JSONObjectWithData:raw options:NSJSONReadingMutableContainers error:NULL] mutableCopy] : nil;
        if (!db) continue;
        NSMutableArray *addons = db[@"addons"];
        if (![addons isKindOfClass:[NSMutableArray class]]) continue;

        NSDictionary *proto = nil;
        NSMutableDictionary *existing = nil;
        for (NSDictionary *entry in addons) {
            if ([entry[@"id"] isEqualToString:kHandoffAddonID]) existing = [entry mutableCopy];
            if (!proto && [entry[@"location"] isEqualToString:@"app-profile"]) proto = entry;
        }
        if (!proto) continue;

        NSMutableDictionary *entry = existing ?: [proto mutableCopy];
        entry[@"id"] = kHandoffAddonID;
        entry[@"syncGUID"] = [[NSUUID UUID] UUIDString];
        entry[@"version"] = @"1.7";
        entry[@"active"] = @YES;
        entry[@"userDisabled"] = @NO;
        entry[@"appDisabled"] = @NO;
        entry[@"seen"] = @YES;
        entry[@"foreignInstall"] = @NO;
        entry[@"signedState"] = @(3);
        entry[@"installDate"] = @((long long)([NSDate date].timeIntervalSince1970 * 1000));
        // Real entries use a jar: rootURI (jar:file://...xpi!/), a plain file://
        // URI is not treated as a package.
        NSString *encoded = [xpiPath stringByReplacingOccurrencesOfString:@" " withString:@"%20"];
        entry[@"rootURI"] = [NSString stringWithFormat:@"jar:file://%@!/", encoded];
        entry[@"path"] = xpiPath;
        entry[@"defaultLocale"] = @{@"name": @"ReynardDefault Handoff"};
        if (existing) {
            NSInteger index = [addons indexOfObjectPassingTest:^BOOL(NSDictionary *obj, NSUInteger i, BOOL *stop) {
                return [obj[@"id"] isEqualToString:kHandoffAddonID];
            }];
            if (index != NSNotFound) [addons replaceObjectAtIndex:index withObject:entry];
        } else {
            [addons addObject:entry];
        }

        NSData *out = [NSJSONSerialization dataWithJSONObject:db options:0 error:NULL];
        if (out) {
            [out writeToFile:dbPath atomically:YES];
            RDLog(@"seeded extensions.json (%lu addons)", (unsigned long)addons.count);
        }
    }
}

static NSString *RDHandoffDirectoryURI(void);
static id RDGeckoBackend(id wrapper);
static id RDRuntimeBackend(void);
static void RDEnsureExtension(id wrapper);
static NSString *RDHandoffXpiURI(void);

// Our callback object must really conform to GeckoView's EventCallback, otherwise
// the Swift side's `as? EventCallback` fails and the response is dropped.
static void RDConformToEventCallback(void) {
    static dispatch_once_t once;
    dispatch_once(&once, ^{
        Protocol *protocol = objc_getProtocol("EventCallback");
        if (!protocol) {
            RDLog(@"EventCallback protocol not found");
            return;
        }
        Class cls = [RDEnsureCallback class];
        if (!class_conformsToProtocol(cls, protocol)) {
            class_addProtocol(cls, protocol);
        }
        RDLog(@"callback conforms=%@", class_conformsToProtocol(cls, protocol) ? @"yes" : @"no");
    });
}

static void RDInstallPackedExtension(void);

static void RDInstallEverywhere(void) {
    if (rdInstallBroadcasted) return;
    rdInstallBroadcasted = YES;
    NSString *location = RDHandoffXpiURI();
    NSMutableSet *seen = [NSMutableSet set];
    for (id wrapper in [rdDispatchers allObjects]) {
        id backend = RDGeckoBackend(wrapper);
        if (!backend || [seen containsObject:backend]) continue;
        [seen addObject:backend];
        if (![backend respondsToSelector:@selector(dispatchToGecko:message:callback:)]) continue;
        NSString *cls = NSStringFromClass([backend class]);
        RDLog(@"install via %@", cls);
        dispatch_async(dispatch_get_main_queue(), ^{
            [(id<RDGeckoDispatch>)backend dispatchToGecko:kInstallEvent
                                                message:@{@"locationUri": location,
                                                          @"installId": [NSString stringWithFormat:@"rd-%d-%@", ++rdInstallCounter, cls],
                                                          @"installMethod": @"manager"}
                                               callback:rdEnsureCallback];
        });
    }
}

static void RDInstallPackedExtension(void) {
    if (rdInstallTried) return;
    rdInstallTried = YES;
    if (!rdGeckoBackend) rdGeckoBackend = rdRuntimeBackend ?: RDRuntimeBackend();
    if (!rdGeckoBackend) return;
        NSString *location = RDHandoffXpiURI();
    RDLog(@"install packed addon %@", location);
    dispatch_async(dispatch_get_main_queue(), ^{
        [(id<RDGeckoDispatch>)rdGeckoBackend dispatchToGecko:kInstallEvent
                                                    message:@{@"locationUri": location,
                                                              @"installId": [NSString stringWithFormat:@"reynarddefault-%d", ++rdInstallCounter],
                                                          @"installMethod": @"manager"}
                                                   callback:rdEnsureCallback];
    });
}

@implementation RDEnsureCallback
- (void)sendSuccess:(id)response {
    rdAddonConfirmed = YES;
    RDLog(@"addon ready: %@", response);
    // The page that is already loaded predates the content script: reload once.
    if (rdGeckoBackend) {
        [(id<RDGeckoDispatch>)rdGeckoBackend dispatchToGecko:@"GeckoView:Reload"
                                                     message:nil callback:nil];
    }
}
- (void)sendError:(id)response {
    RDLog(@"addon error: %@", response);
    if (!rdInstallTried) {
        // Built-in location refused (built-ins normally live in resource://app):
        // fall back to a normal packed install, the user confirms once.
        RDInstallPackedExtension();
    } else {
        rdEnsureDone = YES;
    }
}
@end

// Install the built-in content script extension (it intercepts non-web clicks,
// which the engine swallows without telling the host).
// The wrapper itself does NOT implement dispatchToGecko: — the gecko side lives
// in its `gecko` ivar. Sending it to the wrapper is an unrecognized selector.
// The extension ships inside the dylib: writing it into the app's own container is
// the only path the engine can always read (the /Library copy is not visible to a
// sandboxed app, and handing gecko an unreadable file crashed XUL last time).
static NSString *RDStageHandoffPayload(void) {
    static NSString *base;
    static dispatch_once_t once;
    dispatch_once(&once, ^{
        NSString *dir = [NSTemporaryDirectory() stringByAppendingPathComponent:@"ReynardDefault-handoff"];
        NSFileManager *fm = [NSFileManager defaultManager];
        [fm createDirectoryAtPath:dir withIntermediateDirectories:YES attributes:nil error:NULL];
        NSString *xpiPath = [NSTemporaryDirectory() stringByAppendingPathComponent:@"ReynardDefault-handoff.xpi"];
        NSData *xpi = [NSData dataWithBytes:kHandoffXpi length:kHandoffXpiLen];
        NSData *js = [NSData dataWithBytes:kHandoffJS length:kHandoffJSLen];
        NSData *manifest = [NSData dataWithBytes:kHandoffManifest length:kHandoffManifestLen];
        [xpi writeToFile:xpiPath atomically:YES];
        [manifest writeToFile:[dir stringByAppendingPathComponent:@"manifest.json"] atomically:YES];
        [js writeToFile:[dir stringByAppendingPathComponent:@"handoff.js"] atomically:YES];
        RDLog(@"staged %@ (%lu bytes)", xpiPath, (unsigned long)xpi.length);
        // Second route: drop it into every profile's extensions dir; gecko scans
        // that at start-up, so even a rejected Install ends up loading on relaunch.
        NSString *support = [NSHomeDirectory() stringByAppendingPathComponent:@"Library/Application Support/.mozilla/firefox"];
        for (NSString *profile in [fm contentsOfDirectoryAtPath:support error:NULL] ?: @[]) {
            NSString *ext = [support stringByAppendingPathComponent:
                             [profile stringByAppendingPathComponent:@"extensions"]];
            if (![fm fileExistsAtPath:ext]) continue;
            NSString *target = [ext stringByAppendingPathComponent:@"reynarddefault@local.xpi"];
            if ([[NSData dataWithContentsOfFile:target] isEqualToData:xpi]) continue;
            [xpi writeToFile:target atomically:YES];
            RDLog(@"sideloaded %@", target);
        }
        base = [NSTemporaryDirectory() copy];
    });
    return base;
}

static NSString *RDHandoffDirectoryURI(void) {
    RDStageHandoffPayload();
    return [NSString stringWithFormat:@"file://%@/", [NSTemporaryDirectory() stringByAppendingPathComponent:@"ReynardDefault-handoff"]];
}

static NSString *RDHandoffXpiURI(void) {
    RDStageHandoffPayload();
    return [NSString stringWithFormat:@"file://%@", [NSTemporaryDirectory() stringByAppendingPathComponent:@"ReynardDefault-handoff.xpi"]];
}

static void RDRememberDispatcher(id wrapper) {
    static dispatch_once_t once;
    dispatch_once(&once, ^{ rdDispatchers = [NSHashTable weakObjectsHashTable]; });
    if (wrapper) [rdDispatchers addObject:wrapper];
}

// WebExtension:* commands belong to the runtime dispatcher, not the session one;
// sending them to a session dispatcher is silently ignored (no reply at all).
static id RDRuntimeBackend(void) {
    id fallback = nil;
    for (id wrapper in [rdDispatchers allObjects]) {
        id backend = RDGeckoBackend(wrapper);
        if (!backend) continue;
        NSString *cls = NSStringFromClass([backend class]);
        if (!fallback) fallback = backend;
        if ([cls.lowercaseString containsString:@"runtime"]) {
            RDLog(@"runtime backend %@", cls);
            return backend;
        }
    }
    return fallback;
}

static void RDGeckoDispatchHook(id self, SEL _cmd, NSString *type, id message, id callback) {
    if ([type isEqualToString:kDefaultPrefsEvent] && [message isKindOfClass:[NSDictionary class]]) {
        NSMutableDictionary *prefs = [NSMutableDictionary dictionaryWithDictionary:(NSDictionary *)message];
        prefs[kSignaturePref] = @(NO);
        RDLog(@"prefs injected (%lu keys)", (unsigned long)prefs.count);
        if (rdOrigDispatch) rdOrigDispatch(self, _cmd, type, prefs, callback);
        return;
    }
    if (rdOrigDispatch) rdOrigDispatch(self, _cmd, type, message, callback);
}

// The runtime dispatcher is the one that receives GeckoView:WebExtension:* events.
// Capture its backend from such an event instead of guessing by class name.
static void RDMaybeCaptureRuntime(id wrapper, NSString *type) {
    if (rdRuntimeBackend || ![type hasPrefix:@"GeckoView:WebExtension:"]) return;
    id backend = RDGeckoBackend(wrapper);
    if (!backend) return;
    rdRuntimeBackend = backend;
    RDLog(@"captured runtime backend %@", NSStringFromClass([backend class]));
    // The backend implements dispatchToGecko:message:callback:; hook it directly
    // (the wrapper's Swift convenience method is not exposed to the ObjC runtime).
    static Class hookedClass;
    Class backendClass = object_getClass(backend);
    if (backendClass && backendClass != hookedClass) {
        hookedClass = backendClass;
        MSHookMessageEx(backendClass, @selector(dispatchToGecko:message:callback:),
                        (IMP)RDGeckoDispatchHook, (IMP *)&rdOrigDispatch);
        RDLog(@"backend dispatch hooked=%d", rdOrigDispatch != NULL);
    }
    static BOOL prefSent;
    if (!prefSent) {
        prefSent = YES;
        dispatch_async(dispatch_get_main_queue(), ^{
            [(id<RDGeckoDispatch>)backend dispatchToGecko:@"GeckoView:SetDefaultPrefs"
                                                 message:@{@"xpinstall.signatures.required": @(NO)}
                                                callback:nil];
            RDLog(@"sent signatures.required=false");
        });
    }
    RDEnsureExtension(wrapper);
}

static id RDGeckoBackend(id wrapper) {
    Class cls = [wrapper class];
    unsigned int count = 0;
    Ivar *ivars = class_copyIvarList(cls, &count);
    id backend = nil;
    NSMutableArray *names = [NSMutableArray array];
    for (unsigned int index = 0; index < count; index++) {
        const char *raw = ivar_getName(ivars[index]);
        NSString *name = raw ? @(raw) : @"?";
        [names addObject:name];
        if (!backend && [name.lowercaseString containsString:@"gecko"]) {
            backend = object_getIvar(wrapper, ivars[index]);
        }
    }
    free(ivars);
    if (!backend && [wrapper respondsToSelector:@selector(valueForKey:)]) {
        @try { backend = [wrapper valueForKey:@"gecko"]; } @catch (NSException *exception) {
            (void)exception;
        }
    }
    static BOOL loggedIvars;
    if (!loggedIvars) { loggedIvars = YES; RDLog(@"backend=%@ ivars=%@",
        backend ? @"yes" : @"no", [names componentsJoinedByString:@","]); }
    return backend;
}

static void RDEnsureExtension(id wrapper) {
    static int tries;
    RDConformToEventCallback();
    static BOOL logged;
    if (rdEnsureDone || !wrapper) return;

    id backend = rdRuntimeBackend ?: RDRuntimeBackend();
    if (!backend || ![backend respondsToSelector:@selector(dispatchToGecko:message:callback:)]) {
        if (!logged) {
            logged = YES;
            RDLog(@"no gecko backend, addon skipped for now");
        }
        if (++tries > 80) rdEnsureDone = YES;
        return;
    }

    rdEnsureDone = YES;
    rdGeckoBackend = backend;
    if (!rdEnsureCallback) rdEnsureCallback = [RDEnsureCallback new];
    NSString *location = RDHandoffDirectoryURI();
    dispatch_async(dispatch_get_main_queue(), ^{
        [(id<RDGeckoDispatch>)backend dispatchToGecko:kEnsureEvent
                                              message:@{@"locationUri": location,
                                                        @"webExtensionId": kHandoffAddonID}
                                             callback:rdEnsureCallback];
    });

    // No answer (callback dropped / engine refuses) -> install the packed copy.
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(2.0 * NSEC_PER_SEC)),
                   dispatch_get_global_queue(QOS_CLASS_UTILITY, 0), ^{
        if (!rdAddonConfirmed) {
            RDLog(@"fallback: install on every known dispatcher");
            RDInstallEverywhere();
        }
    });
}

static NSString *RDURLFromPayload(id node) {
    if ([node isKindOfClass:[NSString class]]) {
        NSString *text = (NSString *)node;
        if ([text hasPrefix:@"{"] || [text hasPrefix:@"["]) {
            id parsed = [NSJSONSerialization JSONObjectWithData:[text dataUsingEncoding:NSUTF8StringEncoding]
                                                       options:0 error:NULL];
            if (parsed) {
                NSString *nested = RDURLFromPayload(parsed);
                if (nested) return nested;
            }
        }
        NSString *scheme = [NSURL URLWithString:text].scheme.lowercaseString;
        if (scheme.length && ![RDInternalSchemes() containsObject:scheme]) return text;
        return nil;
    }
    if ([node isKindOfClass:[NSDictionary class]]) {
        for (id value in [(NSDictionary *)node allValues]) {
            NSString *found = RDURLFromPayload(value);
            if (found) return found;
        }
        return nil;
    }
    if ([node isKindOfClass:[NSArray class]]) {
        for (id value in (NSArray *)node) {
            NSString *found = RDURLFromPayload(value);
            if (found) return found;
        }
    }
    return nil;
}

static BOOL RDHandoffAllowed(void) {
    return RDReadBoolPref(kEnabledKey, YES) && RDReadBoolPref(kHandoffKey, YES);
}

// Schemes Gecko must keep rendering itself.
static NSSet *RDInternalSchemes(void) {
    static NSSet *schemes;
    static dispatch_once_t once;
    dispatch_once(&once, ^{
        schemes = [NSSet setWithArray:@[
            @"http", @"https", @"about", @"data", @"blob", @"javascript",
            @"moz-extension", @"jar", @"view-source", @"file", @"resource",
            @"wyciwyg", @"ws", @"wss", @"ftp"
        ]];
    });
    return schemes;
}

static void RDOpenExternally(NSURL *url) {
    dispatch_async(dispatch_get_main_queue(), ^{
        UIApplication *application = [UIApplication sharedApplication];
        [application openURL:url options:@{} completionHandler:^(BOOL success) {
            RDLog(@"open %@ ok=%d", url.scheme, success);
        }];
    });
}

%group ReynardGroup

%hook _TtC9GeckoView27GeckoEventDispatcherWrapper
- (instancetype)init {
    id result = %orig;
    RDRememberDispatcher(result);
    return result;
}
%end

// SetDefaultPrefs is sent *to* gecko (outbound), so it never reaches
// dispatchToSwift:. Merge the signature pref into that first payload.
%hook _TtC9GeckoView27GeckoEventDispatcherWrapper
- (void)dispatch:(NSString *)type message:(id)message callback:(id<RDEventCallback>)callback {
    if ([type isEqualToString:kDefaultPrefsEvent] && [message isKindOfClass:[NSDictionary class]]) {
        NSMutableDictionary *prefs = [NSMutableDictionary dictionaryWithDictionary:(NSDictionary *)message];
        prefs[kSignaturePref] = @(NO);
        RDLog(@"prefs injected (%lu keys)", (unsigned long)prefs.count);
        %orig(type, prefs, callback);
        return;
    }
    %orig;
}
%end

%hook _TtC9GeckoView27GeckoEventDispatcherWrapper

- (void)dispatchToSwift:(NSString *)type message:(id)message callback:(id<RDEventCallback>)callback {
    RDMaybeCaptureRuntime(self, type);
    if (!rdEnsureDone) RDEnsureExtension(self);

    if ([type isEqualToString:kDefaultPrefsEvent]) {
        // Inject the pref into the very first payload so the profile scan and the
        // install validation both run with signature checks off.
        NSMutableDictionary *prefs = [NSMutableDictionary dictionaryWithDictionary:(NSDictionary *)message];
        prefs[kSignaturePref] = @(NO);
        RDLog(@"prefs injected (%lu keys)", (unsigned long)prefs.count);
        %orig(type, prefs, callback);
        return;
    }

    if ([type isEqualToString:kInstallPromptEvent]) {
        NSString *dump = [NSString stringWithFormat:@"%@", message];
        if ([dump containsString:kHandoffAddonID]) {
            RDLog(@"auto-confirming install prompt");
            [callback sendSuccess:@{@"allow": @YES,
                                    @"privateBrowsingAllowed": @YES,
                                    @"isTechnicalAndInteractionDataGranted": @YES}];
            return;
        }
        %orig;
        return;
    }

    if ([type isEqualToString:kMessageEvent] || [type isEqualToString:kPortMessageEvent] ||
        [type hasSuffix:@"WebExtension:Message"] || [type hasSuffix:@"WebExtension:PortMessage"]) {
        NSString *dump = [NSString stringWithFormat:@"%@", message];
        if ([dump containsString:@"rdDebug"]) RDLog(@"script: %@", dump);
        NSString *found = RDURLFromPayload(message);
        if (found && RDHandoffAllowed() && RDClaimHandoff(found)) {
            RDLog(@"handoff(script) %@", found);
            RDOpenExternally([NSURL URLWithString:found]);
        }
        %orig;
        return;
    }

    BOOL isRequest = [type isEqualToString:kOnLoadRequestEvent] ||
                      [type hasSuffix:@"OnLoadRequest"] ||
                      [type hasSuffix:@"OnPreNavigation"];
    BOOL isError = [type hasSuffix:@"OnLoadError"];
    BOOL isVisited = [type hasSuffix:@"OnVisited"];
    if ((!isRequest && !isError && !isVisited) || ![message isKindOfClass:[NSDictionary class]]) {
        if ([type isEqualToString:@"GeckoView:PageTitleChanged"]) {
            RDLog(@"title %@", message);
        } else if ([type hasPrefix:@"GeckoView:WebExtension:On"]) {
            RDLogOnce(type, message);
        } else {
            RDLogTypeOnce(type);
        }
        %orig;
        return;
    }

    NSDictionary *payload = (NSDictionary *)message;
    NSString *uri = [payload[@"uri"] isKindOfClass:[NSString class]] ? payload[@"uri"] : nil;
    if (!uri.length && [payload[@"url"] isKindOfClass:[NSString class]]) uri = payload[@"url"];
    if (!uri.length && [payload[@"lastVisitedURL"] isKindOfClass:[NSString class]]) {
        uri = payload[@"lastVisitedURL"];
    }
    NSURL *url = uri.length ? [NSURL URLWithString:uri] : nil;
    NSString *scheme = url.scheme.lowercaseString;
    BOOL topLevel = RDBoolValue(payload[@"isTopLevel"], YES);
    BOOL userInitiated = RDBoolValue(payload[@"isUserInitiatedNavigation"], YES);
    RDLog(@"%@ scheme=%@ top=%d user=%d msg=%@", type, scheme, topLevel, userInitiated, payload);

    // Sentinels from the content script: a normal https navigation carrying the
    // real target after the fragment.
    if ([uri hasPrefix:@"https://reynarddefault.open"]) {
        NSRange marker = [uri rangeOfString:@"#u="];
        if (marker.location != NSNotFound) {
            NSString *encoded = [uri substringFromIndex:NSMaxRange(marker)];
            NSString *target = [encoded stringByRemovingPercentEncoding];
            NSURL *targetURL = target.length ? [NSURL URLWithString:target] : nil;
            if (targetURL.scheme.length) {
                RDLog(@"sentinel -> %@", targetURL.absoluteString);
                RDOpenExternally(targetURL);
                if (!isError) [callback sendSuccess:@(YES)];
                return;
            }
        }
    }

    BOOL wanted = scheme.length > 0 && ![RDInternalSchemes() containsObject:scheme];
    if (!wanted || !topLevel || !RDHandoffAllowed()) {
        %orig;
        return;
    }

    if (isVisited) {
        // History event: keep the app's own handling, just open the app too.
        %orig;
        if (RDClaimHandoff(url.absoluteString)) {
            RDLog(@"handoff(visited) %@ %@", scheme, url.absoluteString);
            RDOpenExternally(url);
        }
        return;
    }

    if (!RDClaimHandoff(url.absoluteString)) {
        %orig;
        return;
    }

    RDLog(@"handoff %@ %@", scheme, url.absoluteString);
    RDOpenExternally(url);

    if (isError) {
        // Known failure path for unknown schemes: replace the error page with
        // an empty document, the user is already in the other app.
        [callback sendSuccess:@""];
    } else {
        // true == "handled by the app", Gecko stops the navigation.
        [callback sendSuccess:@(YES)];
    }
}

%end

%end

static void RDInstallHook(int attempt) {
    Class dispatcher = objc_getClass(kDispatcherClass.UTF8String);
    if (dispatcher) {
        %init(ReynardGroup);
        RDLog(@"hook installed after %d attempt(s)", attempt);
        return;
    }
    if (attempt >= 100) {
        RDLog(@"dispatcher class never showed up");
        return;
    }
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.2 * NSEC_PER_SEC)),
                   dispatch_get_global_queue(QOS_CLASS_UTILITY, 0), ^{
        RDInstallHook(attempt + 1);
    });
}

%ctor {
    NSString *bundleID = [NSBundle mainBundle].bundleIdentifier;
    if (![bundleID isEqualToString:kReynardBundleID]) return;
    // Write the package first, then the DB record, so one launch is enough:
    // gecko's profile starts after this constructor.
    RDStageHandoffPayload();
    RDSeedExtensionsDatabase();
    RDLog(@"loaded in %@ enabled=%d handoff=%d", bundleID,
          RDReadBoolPref(kEnabledKey, YES), RDReadBoolPref(kHandoffKey, YES));
    RDInstallHook(0);
}
