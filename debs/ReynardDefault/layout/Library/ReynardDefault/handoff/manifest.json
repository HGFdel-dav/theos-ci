{
  "manifest_version": 2,
  "browser_specific_settings": {
    "gecko": {
      "id": "reynarddefault@local",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "name": "ReynardDefault Handoff",
  "version": "1.7",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": false,
      "js": [
        "handoff.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "tabs",
    "<all_urls>"
  ]
}