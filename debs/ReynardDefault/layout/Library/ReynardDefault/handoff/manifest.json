{
  "manifest_version": 2,
  "name": "ReynardDefault Handoff",
  "version": "1.1",
  "browser_specific_settings": {
    "gecko": { "id": "reynarddefault@local" }
  },
  "applications": {
    "gecko": { "id": "reynarddefault@local" }
  },
  "permissions": [
    "geckoViewAddons",
    "nativeMessagingFromContent",
    "<all_urls>",
    "storage",
    "tabs"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "run_at": "document_start",
      "js": ["handoff.js"]
    }
  ]
}
