{
  "manifest_version": 2,
  "name": "ReynardDefault Handoff",
  "version": "1.0",
  "browser_specific_settings": {
    "gecko": { "id": "reynarddefault@local" }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "run_at": "document_start",
      "js": ["handoff.js"]
    }
  ]
}
