{
  "manifest_version": 2,
  "browser_specific_settings": {
    "gecko": {
      "id": "reynarddefault@local"
    }
  },
  "name": "ReynardDefault Handoff",
  "version": "1.2",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "js": ["handoff.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "mozillaAddons",
    "geckoViewAddons",
    "nativeMessaging",
    "nativeMessagingFromContent",
    "storage",
    "tabs",
    "<all_urls>"
  ]
}
