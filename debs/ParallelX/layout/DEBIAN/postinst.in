#!/bin/sh
set -e
PREFIX="__PREFIX__"
LIBDIR="$PREFIX/Library/MobileSubstrate/DynamicLibraries"
# Do not respring here. Installation and SpringBoard reload are separate
# user-approved operations, especially while recovering from safe mode.
for name in ParallelXClone ParallelXPrefsUI; do
    if [ -f "$LIBDIR/$name.dylib" ]; then chmod 755 "$LIBDIR/$name.dylib"; fi
    if [ -f "$LIBDIR/$name.plist" ]; then chmod 644 "$LIBDIR/$name.plist"; fi
done

# URL handoffs (share sheet, extensions) are opened inside the SOURCE process,
# so the router must exist there too. Authorise every installed executable,
# including .appex extensions; SB keeps the application-request path.
PLIST="$LIBDIR/ParallelXClone.plist"
if [ -f "$PLIST" ]; then
    {
        echo '<?xml version="1.0" encoding="UTF-8"?>'
        echo '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">'
        echo '<plist version="1.0"><dict><key>Filter</key><dict>'
        echo '<key>Bundles</key><array><string>com.apple.springboard</string></array>'
        echo '<key>Executables</key><array><string>WebContent</string>'
        for app in /var/containers/Bundle/Application/*/*.app /var/mobile/Containers/Bundle/Application/*/*.app \
                   /var/containers/Bundle/Application/*/*/PlugIns/*.appex /var/mobile/Containers/Bundle/Application/*/*/PlugIns/*.appex; do
            [ -d "$app" ] || continue
            name=${app##*/}; name=${name%.app}; name=${name%.appex}
            case "$name" in ""|SpringBoard) continue ;; esac
            echo "			<string>$name</string>"
        done
        echo '</array></dict></dict></plist>'
    } > "$PLIST.tmp" && chmod 644 "$PLIST.tmp" && mv "$PLIST.tmp" "$PLIST"
fi

exit 0
