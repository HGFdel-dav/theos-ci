  "original_root_items": [
    {
      "cell": "PSGroupCell",
      "label": "CleanStatus 0.2.0",
      "footerText": "除“隐藏未知部件提示”默认开启外，其余默认关闭。修改后点右上角“应用”。关闭总开关并应用可恢复系统显示。"
    },
    {
      "cell": "PSSwitchCell",
      "label": "启用插件",
      "key": "enabled",
      "defaults": "com.local.cleanstatus",
      "default": false,
      "get": "readPreferenceValue:",
      "set": "setPreferenceValue:specifier:"
    },
    {
      "cell": "PSGroupCell",
      "label": "状态栏",
      "footerText": "只隐藏状态图标，不停用系统功能；Siri/CarPlay 仅针对状态栏指示，不隐藏 Siri 界面或车辆仪表。"
    },
    {
      "cell": "PSSwitchCell",
      "label": "隐藏飞行模式",
      "key": "hideAirplane",
      "defaults": "com.local.cleanstatus",
